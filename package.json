{
  "name": "gozargah",
  "version": "2.12.0",
  "private": true,
  "description": "Gozargah - adaptive multi-protocol Cloudflare Worker panel with D1, VLESS/Trojan/Shadowsocks AEAD, DNS-over-HTTPS/DNS64, local online learning, adaptive policy and bounded recovery",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/build-preview.mjs",
    "test": "npm run test:engine && npm run test:integration",
    "test:engine": "node scripts/test.mjs",
    "test:integration": "vitest run",
    "build:pages": "node scripts/build-pages-worker.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.4"
  }
}
