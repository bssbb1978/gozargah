{
  "name": "gozargah",
  "version": "1.3.0",
  "private": true,
  "description": "Gozargah - a beautiful, secure, multi-user VLESS/Trojan panel on Cloudflare Workers with real byte accounting, per-operator tuning, Xray auto-best and D1 storage",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/build-preview.mjs",
    "test": "npm run test:engine && npm run test:integration",
    "test:engine": "node scripts/test.mjs",
    "test:integration": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
